DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trajet_ci
SESSION_SECRET=replace-with-a-long-random-string

# ── Online ticket payment (PayDunya) ─────────────────────────────────────────
# Keys: PayDunya account → "Intégration API" (use the TEST keys with PAYDUNYA_MODE=test).
# Without these, the app runs but online ticket payment answers 503.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test = sandbox (https://app.paydunya.com/sandbox-api/v1), live = real payments. Required in production.
PAYDUNYA_MODE=test
# Public URL of the site, used for PayDunya's return/cancel pages and the webhook
# (webhook = APP_PUBLIC_URL + /api/payments/paydunya-webhook, must be reachable from the internet).
APP_PUBLIC_URL=

# ── Login codes (OTP) ────────────────────────────────────────────────────────
# Ivorian numbers (+225): SMS through Orange "SMS Côte d'Ivoire" (https://developer.orange.com/apis/sms-ci).
# Client ID / secret: Orange Developer → your application. Without them, the code goes by e-mail
# when the account has one, otherwise the login answers with a clear error.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Optional sender name approved by Orange (11 letters, digits or spaces max). Empty = Orange's default.
ORANGE_SMS_SENDER_NAME=
# Other numbers, and fallback when the SMS fails: e-mail through Resend (domain verified on Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Development only: returns the code in the API response and sends nothing.
# Ignored (with a critical log line) when NODE_ENV=production.
ALLOW_DEV_OTP=
