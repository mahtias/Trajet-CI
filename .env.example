DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trajet_ci
SESSION_SECRET=replace-with-a-long-random-string

# ── Online ticket payment (PayDunya) ─────────────────────────────────────────
# Keys: PayDunya account → "Intégration API" (use the TEST keys with PAYDUNYA_MODE=test).
# Without these, the app runs but online ticket payment answers 503.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test = sandbox (https://app.paydunya.com/sandbox-api/v1), live = real payments. Required in production.
PAYDUNYA_MODE=test
# Public URL of the site, used for PayDunya's return/cancel pages and the webhook
# (webhook = APP_PUBLIC_URL + /api/payments/paydunya-webhook, must be reachable from the internet).
APP_PUBLIC_URL=
